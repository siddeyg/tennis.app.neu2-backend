# ========================================
# BACKEND PRODUCTION ENVIRONMENT
# ========================================
#
# IMPORTANT: Copy this file to .env.production and fill in real values
# DO NOT commit .env.production to git (already excluded in .gitignore)
#
# Generate secrets using:
#   Windows: [System.BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).Replace("-","").ToLower()
#   Linux/Mac: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#

# ========================================
# DATABASE
# ========================================
# MongoDB connection string
# Atlas example: mongodb+srv://username:password@cluster.mongodb.net/tennis-coach?retryWrites=true&w=majority
# Self-hosted example: mongodb://username:password@mongodb.example.com:27017/tennis-coach?authSource=admin
MONGO_URI=mongodb://username:password@host:port/database

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
NODE_ENV=production

# ========================================
# JWT AUTHENTICATION
# ========================================
# CRITICAL: Generate new 256-bit (64-character hex) secrets for production
# DO NOT reuse development secrets
JWT_SECRET=GENERATE_NEW_64_CHARACTER_HEX_STRING
REFRESH_TOKEN_SECRET=GENERATE_NEW_64_CHARACTER_HEX_STRING
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ========================================
# CORS CONFIGURATION
# ========================================
# Admin Portal URL
CORS_ORIGIN=https://mondo.suwar.de

# Student Portal URL
CORS_ORIGIN_STUDENT=https://student.mondo.suwar.de

# Coach Portal URL
CORS_ORIGIN_COACH=https://coach.mondo.suwar.de

# ========================================
# IBAN ENCRYPTION
# ========================================
# For Seasonal Registration SEPA payments
# CRITICAL: Generate new 256-bit (64-character hex) key for production
IBAN_ENCRYPTION_KEY=GENERATE_NEW_64_CHARACTER_HEX_STRING

# ========================================
# EMAIL SERVICE (SendGrid)
# ========================================
# Required for password reset and email verification
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Verified sender email (must be verified in SendGrid)
FROM_EMAIL=noreply@mondo.suwar.de

# Sender name displayed in emails
FROM_NAME=TC GW Am Kreuzberg

# ========================================
# FRONTEND URLS
# ========================================
# Used for generating links in emails
FRONTEND_URL=https://mondo.suwar.de
STUDENT_PORTAL_URL=https://student.mondo.suwar.de
COACH_PORTAL_URL=https://coach.mondo.suwar.de

# ========================================
# LOGGING & MONITORING (Optional)
# ========================================
# Log level: error, warn, info, http, debug
LOG_LEVEL=info

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
