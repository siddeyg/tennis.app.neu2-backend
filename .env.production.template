# Backend Production Environment Configuration
# File location on server: /srv/mondo/backend/.env.production

# ============================================================================
# CRITICAL: Generate REAL secrets before deployment!
# Run on LOCAL machine:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# MongoDB Connection
# NOTE: docker-compose.yml overrides this with full auth URI
# This is used as fallback if env_file fails
MONGO_URI=mongodb://mongo:27017/tennis-coach
PORT=5000

# JWT Authentication (256-bit secrets required!)
# Generate TWO different secrets:
JWT_SECRET=REPLACE_WITH_REAL_SECRET_1
REFRESH_TOKEN_SECRET=REPLACE_WITH_REAL_SECRET_2
PORTAL_JWT_SECRET=REPLACE_WITH_REAL_SECRET_3

JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# IBAN Encryption (for seasonal registration SEPA data)
# Generate DIFFERENT secret from JWT secrets:
IBAN_ENCRYPTION_KEY=REPLACE_WITH_REAL_SECRET_4

# CORS Configuration - Allow all three portals
CORS_ORIGIN=https://mondo.suwar.de
CORS_ORIGIN_STUDENT=https://user.suwar.de
CORS_ORIGIN_COACH=https://coach.suwar.de

# Frontend URLs (for email links)
FRONTEND_URL=https://mondo2.suwar.de
STUDENT_PORTAL_URL=https://user.suwar.de
COACH_PORTAL_URL=https://coach.suwar.de

# Email Service (SMTP Configuration)
# Using existing TC GW email
SMTP_HOST=smtp.artfiles.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tcgw-nvr@diemachtderworte.de
SMTP_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
FROM_EMAIL=tcgw-nvr@diemachtderworte.de
FROM_NAME=TC GW Am Kreuzberg

# Environment
NODE_ENV=production
LOG_LEVEL=info

# Optional: Monitoring/Analytics
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ============================================================================
# DEPLOYMENT CHECKLIST:
# ============================================================================
# [ ] Generate 4 unique 256-bit secrets (see commands above)
# [ ] Replace ALL "REPLACE_WITH_REAL_SECRET_X" placeholders
# [ ] Add SMTP password for email service
# [ ] Verify CORS_ORIGIN includes all portal domains
# [ ] Verify frontend URLs point to new domains
# [ ] NEVER commit this file to git (.gitignore protects it)
# ============================================================================
