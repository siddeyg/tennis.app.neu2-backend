# Backend Environment Configuration
# Copy this file to .env.development for local development
# Copy this file to .env.production for production deployment

# ==============================================================================
# DATABASE
# ==============================================================================
# MongoDB connection URI
# Development: mongodb://localhost:27017/tennis-coach
# Production: mongodb://<username>:<password>@<host>:<port>/tennis-coach
MONGO_URI=mongodb://localhost:27017/tennis-coach

# ==============================================================================
# SERVER
# ==============================================================================
# Port for Express server (default: 5000)
PORT=5000

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Generate new secrets for production using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT access token secret (256-bit random hex)
JWT_SECRET=your-256-bit-secret-here-change-for-production

# JWT refresh token secret (256-bit random hex, DIFFERENT from JWT_SECRET)
REFRESH_TOKEN_SECRET=your-different-256-bit-secret-here-change-for-production

# Token expiration times
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Allowed origins for CORS (comma-separated for multiple origins)
# Development: http://localhost:3000
# Production: https://mondo.suwar.de,https://student.mondo.suwar.de,https://coach.mondo.suwar.de
CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN_STUDENT=http://localhost:3001
CORS_ORIGIN_COACH=http://localhost:3002

# ==============================================================================
# IBAN ENCRYPTION (Seasonal Registration SEPA Payment)
# ==============================================================================
# 256-bit encryption key for IBAN data (AES-256-CBC)
# Generate new key for production using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ CRITICAL: Generate NEW key for production, do NOT reuse development key
IBAN_ENCRYPTION_KEY=your-256-bit-encryption-key-here-change-for-production

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Environment mode: development | production | test
NODE_ENV=development

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# 1. NEVER commit .env files to Git (.gitignore should exclude them)
# 2. Generate NEW secrets for production (do NOT reuse development secrets)
# 3. Use strong 256-bit (64 character hex) secrets for JWT and encryption
# 4. Keep JWT_SECRET and REFRESH_TOKEN_SECRET different
# 5. IBAN_ENCRYPTION_KEY must be 256-bit (32 bytes = 64 hex characters)
# 6. Rotate secrets periodically (every 6-12 months recommended)
# 7. Store production secrets in secure secret management system (AWS Secrets Manager, Azure Key Vault, etc.)
